# Synthetic values only. Real values belong in the private estate.
NDS_IMAGE=nds-server:example
NDS_PUBLIC_HOST=nds.example.invalid
NDS_PUBLIC_ORIGIN=https://nds.example.invalid
NDS_HTTPS_BIND=127.0.0.1
